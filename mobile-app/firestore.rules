rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null && data.keys().hasAll(['role'])
        ? data.role
        : 'none';
    }

    // The shared website contract uses "manager" for management access.
    // "admin" remains a distinct privileged role and is not implicitly a manager.
    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function validPublicRole(role) {
      return role in ['member', 'volunteer', 'donor'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isManager() || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && validPublicRole(request.resource.data.role)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow update: if (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.role == resource.data.role
        ) || isAdmin();

      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if isAuthenticated()
        && getUserRole() == 'volunteer'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;

      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isManager() || isAdmin());

      allow update: if (isManager() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.decidedAt is string;

      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if true;
      allow create, update, delete: if isManager() || isAdmin();
    }

    match /news_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isManager() || isAdmin();
    }

    // Public contact submission is intentionally limited to validated fields.
    // Coordinate this with the website developer before deploying shared rules.
    match /mail/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;

      allow read, update, delete: if isManager() || isAdmin();
    }

    match /donations/{donationId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isManager() || isAdmin());
      allow update, delete: if isManager() || isAdmin();
    }

    match /pledges/{pledgeId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isManager() || isAdmin());
      allow update, delete: if isManager() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (
          resource.data.uid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );
      allow create, update, delete: if isManager() || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
